# Vercel KV (Redis) Configuration
# When you integrate Redis in Vercel, these variables are auto-populated

# Primary KV access (used by @vercel/kv)
KV_REST_API_URL=your_vercel_kv_url_here
KV_REST_API_TOKEN=your_vercel_kv_token_here

# Alternative Vercel KV variables (auto-populated by Vercel)
REDIS_URL=
KV_URL=

# Application Configuration
BASE_URL=https://sho.rt
NODE_ENV=development
